# ===============================================
# Containerfile - OpenFHE + Pyfhel + Python 3.12 
# ===============================================
#
# Contents:
#   - Ubuntu 24.04 LTS 
#   - Python 3.12 
#   - OpenFHE C++ 1.5.0 compiled from source, available on a virtualenv with the 
#     official openfhe-python bindings (1.4.2).
#   - Pyfhel 3.5.0 compiled from source, available on the same virtualenv.
#   - See requirements.txt for the Python dependencies installed in the virtualenv.
#
# Multi-stage:
#   Stage 1 (builder): compiling OpenFHE C++, python bindings and Pyfhel.
#   Stage 2 (runtime): final image without compilers.
#
# Building and running the container:
#   1. Building the container:
#      podman build \
#       --build-arg BUILD_DATE="$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
#       --build-arg VCS_REF="$(git rev-parse --short HEAD 2>/dev/null || echo 'no-git')" \
#       -t qhe:1.0 -f Containerfile .        
#   2. Running the container with a volume mount to the current directory and port forwarding for JupyterLab:
#      podman run -v $(pwd):/workspace:Z -p 8888:8888 localhost/qhe:1.0
#   3. Running the container with an interactive shell:
#      podman run -it --entrypoint /bin/bash localhost/qhe:1.0
#   4. Running the container with a custom Jupyter Server configuration:
#      podman run -v jupyter_server_config.json:/etc/jupyter/jupyter_server_config.json:ro \
#       -v $(pwd):/workspace:Z -p 8888:8888 localhost/qhe:1.0
# ============================================================

# BUILDER
FROM public.ecr.aws/ubuntu/ubuntu:24.04 AS builder
#FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Madrid

# Preparing system
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        wget \
        ca-certificates \
        autoconf \
        libomp-dev \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* && python3.12 -m pip install \
       --no-cache-dir --break-system-packages "pybind11[global]"

# Compiling OpenFHE (C++)
ARG OPENFHE_VERSION=v1.4.2
WORKDIR /opt
RUN git clone --depth 1 --branch ${OPENFHE_VERSION} \
        https://github.com/openfheorg/openfhe-development.git

WORKDIR /opt/openfhe-development/build
RUN cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_UNITTESTS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_BENCHMARKS=OFF \
        -DBUILD_EXTRAS=OFF \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        .. && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig

# Bindings openfhe-python 
ARG OPENFHE_PYTHON_VERSION=v1.4.2.0
WORKDIR /opt
RUN git clone --depth 1 --branch ${OPENFHE_PYTHON_VERSION} \
        https://github.com/openfheorg/openfhe-python.git

WORKDIR /opt/openfhe-python/build
RUN cmake \
        -DPYTHON_EXECUTABLE_PATH="$(which python3.12)" \
        .. && \
    make -j"$(nproc)" && \
    make install

# Installing Pyfhel
ARG PYFHEL_VERSION=v3.5.0
WORKDIR /opt
RUN git clone --depth 1 --branch ${PYFHEL_VERSION} --recursive \
        https://github.com/ibarrond/Pyfhel.git

WORKDIR /opt/Pyfhel
RUN python3.12 -m pip install --no-cache-dir --break-system-packages \
        "setuptools>=64" wheel "Cython>=3.0" "numpy>=1.20" && \
    python3.12 -m pip wheel --no-cache-dir --no-deps \
        --wheel-dir=/opt/wheels .    

# RUNTIME
FROM ubuntu:24.04 AS runtime

# Metadata
LABEL org.opencontainers.image.title="qhe" \
      org.opencontainers.image.description="Development environment for TFM on quantum computing and homomorphic encryption. Includes OpenFHE C++ with real CKKS bootstrapping and Pyfhel, in a Python 3.12 virtualenv on Ubuntu 24.04." \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.authors="José Ángel de Bustos Pérez <jadebustos@gmail.com>" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.source="https://github.com/jadebustos/qhe/" \
      org.opencontainers.image.url="https://quay.io/repository/rhte_2019/qhe" \
      org.opencontainers.image.documentation="https://github.com/jadebustos/qhe/blob/main/README.md" \
      org.opencontainers.image.base.name="docker.io/library/ubuntu:24.04"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Madrid
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Preparing the system without compilers
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        ca-certificates \
        python3.12 \
        python3.12-venv \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3

# Copy OpenFHE C++ library from builder
COPY --from=builder /usr/local/lib/libOPENFHE*.so* /usr/local/lib/
COPY --from=builder /usr/local/include/openfhe /usr/local/include/openfhe

# Copy OpenFHE python module from builder
COPY --from=builder /usr/openfhe.cpython-312-*.so /tmp/

# Copy Pyfhel wheel from builder.
COPY --from=builder /opt/wheels/pyfhel-*.whl /tmp/

ENV LD_LIBRARY_PATH=/usr/local/lib
RUN ldconfig

# non-root user setup
ARG USERNAME=qcomputing
RUN if id ubuntu >/dev/null 2>&1; then \
        usermod -l ${USERNAME} ubuntu && \
        groupmod -n ${USERNAME} ubuntu && \
        usermod -d /home/${USERNAME} -m ${USERNAME}; \
    else \
        groupadd --gid 1000 ${USERNAME} && \
        useradd --uid 1000 --gid 1000 --create-home \
                --shell /bin/bash ${USERNAME}; \
    fi && mkdir -p /workspace && chown -R ${USERNAME}:${USERNAME} /workspace

# Enable non-root user
USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Virtual environment setup with OpenFHE preinstalled in /home/${USERNAME}/venv
# To enable it run: source venv/bin/activate
# Installing Python dependencies from requirements.txt.
# Moving the openfhe module to the venv's site-packages.
# Installing Pyfhel from the wheel precompiled in the builder. 
# Enabling the venv when entering the container (for interactive shells).
COPY requirements.txt /home/${USERNAME}/requirements.txt
RUN python3.12 -m venv /home/${USERNAME}/venv && \
    /home/${USERNAME}/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /home/${USERNAME}/venv/bin/pip install --no-cache-dir -r /home/${USERNAME}/requirements.txt -v && \
    cp /tmp/openfhe.cpython-312-*.so /home/${USERNAME}/venv/lib/python3.12/site-packages/ && \
    /home/${USERNAME}/venv/bin/pip install --no-cache-dir /tmp/pyfhel-*.whl && \
    echo "source /home/${USERNAME}/venv/bin/activate" >> /home/${USERNAME}/.bashrc

# Copying Jupyter Server configuration file to the container. 
# This file can be overridden at runtime with a volume mount.
COPY jupyter_server_config.json /home/${USERNAME}/jupyter/certs/jupyter_server_config.json

# Copying certificates for Jupyter Server configuration
# These files can be overridden at runtime with volume mounts.
COPY --chmod=600 jupyter.key /home/${USERNAME}/jupyter/certs/jupyter.key
COPY --chmod=644 jupyter.crt /home/${USERNAME}/jupyter/certs/jupyter.crt

# Copying the LICENSE file to the user's home directory.
COPY LICENSE home/${USERNAME}/LICENSE

# Environment variables to find the OpenFHE and shared libraries
ENV VIRTUAL_ENV=/home/${USERNAME}/venv
ENV PATH=/home/${USERNAME}/venv/bin:$PATH

WORKDIR /workspace

EXPOSE 8888

ENTRYPOINT ["jupyter", "lab"]
